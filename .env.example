# Copy this file to .env and fill in real values. Never commit .env.
# Sanity Studio (Vite) auto-loads SANITY_STUDIO_-prefixed vars from .env.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Optional: token for authenticated scripts (e.g. content migrations).
# Generate at https://www.sanity.io/manage — never expose this to the client.
SANITY_API_TOKEN=
