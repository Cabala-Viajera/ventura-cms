# Optional shared defaults for both development and production.
# Copy to .env
# for command-specific settings. Never commit files containing real values.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_APP_ID=
# Optional: token for authenticated scripts (e.g. content migrations).
# Generate at https://www.sanity.io/manage — never expose this to the client.
SANITY_API_TOKEN=
